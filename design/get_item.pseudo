# Project One Get-Item Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: get-item and inventory design for M7 Project Two
#
# Review the course-provided get-item flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, SET, ADD, or similar terms.

START get_item

    SET current_room = player's current room
    SET inventory = player's current inventory

    OUTPUT "Enter the name of the item you want to pick up."
    INPUT requested_item

    IF requested_item is in inventory
        OUTPUT "You already have that item in your inventory."
    ELSE
        IF requested_item is the item in current_room
            ADD requested_item TO inventory
            OUTPUT "You picked up the ", requested_item, "."
            OUTPUT requested_item, " has been added to your inventory."
        ELSE
            OUTPUT "There is no ", requested_item, " in this room."
        END IF
    END IF

    RETURN inventory

END get_item

