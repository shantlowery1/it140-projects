# Project One Move-Between-Rooms Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: conceptual support for M6; movement design for M7
#
# Review the course-provided movement flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, WHILE, SET, or similar terms.

# The process needs the player's current room and the direction
# the player wants to move.

# Project One Move-Between-Rooms Pseudocode

SET current_room = "Reception"
SET movement_command = ""
SET game_over = FALSE

WHILE game_over == FALSE

    SET move_valid = FALSE

    OUTPUT "Enter a direction: north, south, east, or west."
    INPUT movement_command

    IF current_room == "Reception"

        IF movement_command == "east"
            SET current_room = "Patient Room"
            SET move_valid = TRUE
        ELSE IF movement_command == "north"
            SET current_room = "Warden's Office"
            SET move_valid = TRUE
        END IF

    ELSE IF current_room == "Patient Room"

        IF movement_command == "west"
            SET current_room = "Reception"
            SET move_valid = TRUE
        ELSE IF movement_command == "north"
            SET current_room = "Nurses' Station"
            SET move_valid = TRUE
        END IF

    ELSE IF current_room == "Nurses' Station"

        IF movement_command == "south"
            SET current_room = "Patient Room"
            SET move_valid = TRUE
        ELSE IF movement_command == "north"
            SET current_room = "Treatment Room"
            SET move_valid = TRUE
        END IF

    ELSE IF current_room == "Treatment Room"

        IF movement_command == "south"
            SET current_room = "Nurses' Station"
            SET move_valid = TRUE
        ELSE IF movement_command == "east"
            SET current_room = "Cafeteria"
            SET move_valid = TRUE
        END IF

    ELSE IF current_room == "Cafeteria"

        IF movement_command == "west"
            SET current_room = "Treatment Room"
            SET move_valid = TRUE
        ELSE IF movement_command == "east"
            SET current_room = "Basement"
            SET move_valid = TRUE
        END IF

    ELSE IF current_room == "Basement"

        IF movement_command == "west"
            SET current_room = "Cafeteria"
            SET move_valid = TRUE
        ELSE IF movement_command == "south"
            SET current_room = "Security Office"
            SET move_valid = TRUE
        END IF

    ELSE IF current_room == "Security Office"

        IF movement_command == "north"
            SET current_room = "Basement"
            SET move_valid = TRUE
        ELSE IF movement_command == "west"
            SET current_room = "Warden's Office"
            SET move_valid = TRUE
        END IF

    END IF

    IF move_valid == TRUE
        OUTPUT "You moved to " + current_room
    ELSE
        OUTPUT "You cannot move in that direction."
    END IF

    IF current_room == "Warden's Office"
        OUTPUT "You hear heavy footsteps behind you.."
        OUTPUT "Warden Graves has caught you!"
        OUTPUT "GAME OVER"
        SET game_over = TRUE

    ELSE IF current_room == "Reception" AND player has all six items
        OUTPUT "You use the Exit Key to escape the asylum."
        OUTPUT "YOU WIN!"
        SET game_over = TRUE
    END IF

END WHILE
